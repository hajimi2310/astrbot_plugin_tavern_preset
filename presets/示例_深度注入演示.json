            "name": "Scenario",
            "system_prompt": true,
            "marker": true
        },
        {
            "identifier": "dialogueExamples",
            "name": "Chat Examples",
            "system_prompt": true,
            "marker": true
        },
        {
            "identifier": "chatHistory",
            "name": "Chat History",
            "system_prompt": true,
            "marker": true
        },
        {
            "identifier": "styleReminder",
